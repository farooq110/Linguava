# Linguava - Language Translator Environment Variables

# NextAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional - for email features)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Database
DATABASE_URL=
