# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── dependencies ───
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── testing ───
/coverage

# ─── next.js ───
/.next/
/out/

# ─── production builds ───
/build

# ─── misc ───
.DS_Store
*.pem
Thumbs.db

# ─── debug logs ───
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# ─── env files (never commit secrets!) ───
.env
.env.local
.env.development
.env.production
.env.preview
# But DO commit the template:
!.env.example

# ─── vercel ───
.vercel

# ─── typescript ───
*.tsbuildinfo
next-env.d.ts

# ─── IDE / editor ───
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ─── OS ───
local-*

# ─── sandbox / tooling artifacts (don't ship these) ───
.claude
.z-ai-config
/skills/
/upload/
.zscripts/
/examples/
/mini-services/
test
prompt

# ─── agent worklog (internal coordination log, not for the repo) ───
worklog.md

# ─── generated screenshots (regenerable on demand via agent-browser) ───
/download/screenshots/

# ─── SQLite DB files (runtime data, not source) ───
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# ─── PM2 / process management ───
.pm2/

# ─── Let's Encrypt (if running certbot locally — shouldn't, but just in case) ───
/etc/letsencrypt/

# ─── Terraform / IaC state (if you add it later) ───
*.tfstate
*.tfstate.backup
.terraform/
